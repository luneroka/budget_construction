{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Enforced since 2026-09-15, after a report-only release surfaced no
		# violations. Allowances: Google Fonts (index.css; also in connect-src
		# because html-to-image fetches the stylesheet and font files to embed
		# them in dashboard captures), R2 presigned URLs in the document viewer
		# iframe/img, inline styles from React style props and Tailwind.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://*.r2.cloudflarestorage.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	# The API disables these itself in production; this keeps them hidden at
	# the edge even if that setting ever regresses.
	@api_docs path /api/docs /api/docs/* /api/redoc /api/openapi.json
	handle @api_docs {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		# API responses carry access tokens and financial data: never cache.
		header Cache-Control "no-store"
		# Largest legitimate body is a 20 MB document upload (validated again
		# by the API); everything else is rejected before reaching uvicorn.
		request_body {
			max_size 25MB
		}
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

batibudget.fr, www.batibudget.fr, www.batibudget.com {
	redir https://batibudget.com{uri} permanent
}
