# PostgreSQL
POSTGRES_DB=dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:secret@db:5432/dbname
APP_ENVIRONMENT=development
DATABASE_ECHO=false
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sliding refresh-token session length; the httpOnly refresh cookie's expiry
# extends by this many days on every use while the user stays active.
REFRESH_TOKEN_EXPIRE_DAYS=30

# R2 secrets
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...

# Resend settings
# Use a dedicated dev key here, never the production one: create a separate
# key in the Resend dashboard (naming convention: <project>-staging) with
# sending-only permission, so it can be revoked without touching production.
# Leave this empty to disable outgoing mail entirely in local dev -- password
# reset still completes and logs the failure, but issue reports return 502.
#
# Dev and prod share one verified sending domain, so when you do test mail
# locally, send only to your own inbox or to Resend's test addresses:
#   delivered@resend.dev  -> simulates a successful delivery
#   bounced@resend.dev    -> simulates a hard bounce (SMTP 550)
#   complained@resend.dev -> simulates a spam complaint
# They count against the account quota but never affect domain reputation.
# Never send dev mail to a made-up address: those bounce for real and the
# damage lands on the domain production sends from.
RESEND_API_KEY=
RESEND_FROM=onboarding@yourdomain.com
# Optional: public app URL used to build reset links
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Optional: leave unset in local dev (safe no-op). See .env.production.example.
SENTRY_DSN=
